# --- AI Builder (embedded Flowise UI) — copy into frontend/.env ---
# JWT + API host; client does NOT send cookies cross-origin (avoids strict CORS on /api/v1/*).
# NEXT_PUBLIC_API_BASE_URL=https://your-flowise.up.railway.app
# NEXT_PUBLIC_BEARER_TOKEN=your_jwt
# If you instead need credentialed cookie calls from the browser, set on Flowise server
# (packages/server): CORS_ORIGINS=http://localhost:3000,https://your-app.com and CORS_ALLOW_CREDENTIALS=true
